{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Breadbox",
  "description": "Self-hosted financial data aggregation for households. Sync bank transactions from Plaid, Teller, and CSV into a PostgreSQL database you control, then expose it to AI agents via MCP and REST. Includes a CLI, an admin dashboard, scheduled Claude Agent SDK runs, and a transaction-rule engine for autonomous categorization.",
  "api": {
    "playground": {
      "display": "none"
    }
  },
  "theme": "mint",
  "logo": {
    "light": "/images/fried-egg.svg",
    "dark": "/images/fried-egg.svg",
    "href": "https://breadbox.sh"
  },
  "favicon": {
    "light": "/images/fried-egg.svg",
    "dark": "/images/fried-egg.svg"
  },
  "colors": {
    "primary": "#16A34A",
    "light": "#22C55E",
    "dark": "#15803D"
  },
  "background": {
    "color": {
      "light": "#FCF9F3",
      "dark": "#1A1612"
    }
  },
  "banner": {
    "content": "Breadbox is in early access pending the 0.1.0 release. [See the changelog →](/changelog)",
    "dismissible": true,
    "type": "warning"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/canalesb93/breadbox"
    },
    "links": []
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book-open",
        "pages": [
          {
            "group": "Overview",
            "icon": "sparkles",
            "pages": [
              "introduction",
              "installation",
              "installation/remote-hosting",
              "installation/updating",
              "quickstart"
            ]
          },
          {
            "group": "Bank Connections",
            "icon": "landmark",
            "pages": [
              "connections/overview",
              {
                "group": "Providers",
                "icon": "plug",
                "expanded": true,
                "pages": [
                  "connections/teller",
                  "connections/plaid",
                  "connections/csv-import"
                ]
              }
            ]
          },
          {
            "group": "Transactions",
            "icon": "receipt",
            "pages": [
              "transactions/overview",
              "transactions/categories",
              "transactions/tags",
              "transactions/rules",
              "transactions/review-workflow"
            ]
          },
          {
            "group": "AI Integration",
            "icon": "bot",
            "pages": [
              "mcp/overview",
              "mcp/setup",
              "mcp/tools",
              "guides/scheduled-agents"
            ]
          },
          {
            "group": "Configuration",
            "icon": "settings",
            "pages": [
              "configuration/environment",
              "configuration/app-config",
              "configuration/api-keys",
              "configuration/backup"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "code",
        "anchors": [
          {
            "anchor": "API",
            "icon": "network",
            "groups": [
              {
                "group": "Overview",
                "icon": "info",
                "pages": [
                  "api/overview",
                  "api/authentication",
                  "api/pagination"
                ]
              },
              {
                "group": "Endpoints",
                "icon": "zap",
                "openapi": "https://raw.githubusercontent.com/canalesb93/breadbox/main/openapi.yaml"
              }
            ]
          },
          {
            "anchor": "Model Context Protocol",
            "icon": "bot-message-square",
            "groups": [
              {
                "group": "Overview",
                "icon": "info",
                "pages": [
                  "mcp/reference/overview",
                  "mcp/reference/conventions"
                ]
              },
              {
                "group": "Data Access (Read)",
                "icon": "search",
                "pages": [
                  "mcp/reference/transactions",
                  "mcp/reference/accounts",
                  "mcp/reference/categories",
                  "mcp/reference/tags",
                  "mcp/reference/rules",
                  "mcp/reference/connections-sync"
                ]
              },
              {
                "group": "Mutations (Write)",
                "icon": "pencil",
                "pages": [
                  "mcp/reference/sessions",
                  "mcp/reference/categorization",
                  "mcp/reference/transactions-write",
                  "mcp/reference/tags-write",
                  "mcp/reference/rules-write",
                  "mcp/reference/categories-write",
                  "mcp/reference/matches",
                  "mcp/reference/connections-write",
                  "mcp/reference/reports"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "icon": "terminal",
        "pages": [
          "cli/overview",
          "cli/installation",
          "cli/authentication",
          "cli/output",
          "cli/commands",
          "cli/headless",
          "cli/agents"
        ]
      },
      {
        "tab": "Guides",
        "icon": "map",
        "pages": [
          "guides/overview",
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "guides/breadbox-in-a-nutshell",
              "guides/understanding-rules"
            ]
          },
          {
            "group": "Common Workflows",
            "icon": "repeat",
            "pages": [
              "guides/single-routine-reviewer",
              "guides/multi-agent-reviewer",
              "guides/zelle-venmo-analysis",
              "guides/gmail-cross-referencing",
              "guides/tracking-subscriptions",
              "guides/openclaw-recurring-workflows"
            ]
          },
          {
            "group": "Advanced",
            "icon": "flame",
            "pages": [
              "guides/on-demand-analysis",
              "guides/custom-dashboard-with-claude"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "history",
        "pages": ["changelog"]
      }
    ]
  },
  "redirects": [
    {
      "source": "/transactions/review-queue",
      "destination": "/transactions/review-workflow"
    },
    {
      "source": "/automating-breadbox",
      "destination": "/guides/overview"
    },
    {
      "source": "/quick-start",
      "destination": "/introduction"
    },
    {
      "source": "/index",
      "destination": "/introduction"
    },
    {
      "source": "/api/accounts",
      "destination": "/api/overview"
    },
    {
      "source": "/api/transactions",
      "destination": "/api/overview"
    },
    {
      "source": "/api/categories",
      "destination": "/api/overview"
    },
    {
      "source": "/api/tags",
      "destination": "/api/overview"
    },
    {
      "source": "/api/rules",
      "destination": "/api/overview"
    },
    {
      "source": "/api/connections",
      "destination": "/api/overview"
    },
    {
      "source": "/api/users",
      "destination": "/api/overview"
    },
    {
      "source": "/api/reports",
      "destination": "/api/overview"
    }
  ],
  "search": {
    "prompt": "Search..."
  },
  "errors": {
    "404": {
      "redirect": true
    }
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "metadata": {
    "timestamp": true
  }
}
